{
  "name": "the-good-present",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "workspaces": [
    "apps/site",
    "packages/content-schema"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @the-good-present/site",
    "build": "npm run build --workspace @the-good-present/site",
    "preview": "npm run preview --workspace @the-good-present/site",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "content:validate": "tsx scripts/content-validate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.11",
    "typescript": "6.0.3"
  }
}
