---
import { guidePath, type ClusterHub, type GiftGuide } from "@the-good-present/content-schema";

import { formatDate, primaryAxisLabels } from "../lib/content.js";
import { recommendationIllustrations } from "../lib/illustrations.js";

interface Props {
  guide: GiftGuide;
  cluster: ClusterHub;
  number: number;
  coverImage?: string;
}

const { guide, cluster, number, coverImage } = Astro.props;
const date = guide.updatedAt ?? guide.publishedAt;
const idea = guide.recommendations[0];
const image =
  coverImage ??
  (idea &&
    (recommendationIllustrations[idea.id]?.src ??
      idea.shoppingOptions?.find((option) => option.imageUrl)?.imageUrl));
---

<article class="guide-card">
  <a href={guidePath(cluster.slug, guide.slug)}>
    {image && <img class="guide-card__image" src={image} alt="" loading="lazy" />}
    <div class="guide-card__topline">
      <span>{primaryAxisLabels[guide.primaryAxis]}</span>
      <span aria-hidden="true">0{number}</span>
    </div>
    <h3>{guide.title}</h3>
    <p>{guide.excerpt}</p>
    <div class="guide-card__footer">
      <span>{cluster.title}</span>
      <time datetime={date}>{guide.updatedAt ? "Updated" : "Published"} {formatDate(date)}</time>
    </div>
  </a>
</article>
