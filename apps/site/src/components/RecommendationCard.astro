---
import { sourceLabel } from "../lib/gift-resources.js";
import {
  productDisplayName,
  recommendationDestination,
  type GuideRecommendation,
  type Product,
} from "@the-good-present/content-schema";

interface Props {
  recommendation: GuideRecommendation;
  product?: Product;
  illustration?: { src: string; alt: string; kind?: "photo" };
}

const { recommendation, product, illustration } = Astro.props;
const visual = product?.image
  ? { src: product.image, alt: product.imageAlt!, productPhoto: true }
  : illustration
    ? { ...illustration, productPhoto: illustration.kind === "photo" }
    : undefined;
const destination = recommendationDestination(recommendation, product);
const isDirectAffiliate = Boolean(recommendation.directAffiliateUrl);
const isAffiliate =
  isDirectAffiliate || Boolean(destination && destination === product?.affiliateUrl);
const isDemo = destination ? new URL(destination).hostname === "example.com" : false;
const linkRel = isAffiliate ? "sponsored nofollow noopener" : "nofollow noopener";
const merchantLabel = product?.merchant.replace(" (demo)", "");
const displayName = product ? productDisplayName(product) : undefined;
const selectionGuidance =
  "selectionGuidance" in recommendation ? recommendation.selectionGuidance : undefined;
const editorialHeading =
  recommendation.heading && !product?.name.startsWith(recommendation.heading)
    ? recommendation.heading
    : undefined;
const title = editorialHeading ?? displayName ?? "Gift idea";
const initials = title
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0])
  .join("");
const accent = `recommendation--accent-${((recommendation.position - 1) % 4) + 1}`;
---

<article class:list={["recommendation", accent]} id={`pick-${recommendation.position}`}>
  <div
    class:list={[
      "recommendation__visual",
      visual && "recommendation__visual--illustrated",
      visual?.productPhoto && "recommendation__visual--product-photo",
    ]}
    aria-hidden={visual ? undefined : "true"}
  >
    {
      visual ? (
        <img src={visual.src} alt={visual.alt} loading="lazy" decoding="async" />
      ) : (
        <span>{initials}</span>
      )
    }
    <small>Pick {recommendation.position}</small>
  </div>
  <div class="recommendation__body">
    <p class="recommendation__position">Recommendation {recommendation.position}</p>
    <h2>{title}</h2>
    {product && editorialHeading && <p class="recommendation__product">{displayName}</p>}
    <p>{recommendation.editorialDescription}</p>
    <div class="why-box">
      <h3>Why it fits</h3>
      <p>{recommendation.whyItFits}</p>
    </div>
    {
      (recommendation.bestFor || selectionGuidance || recommendation.considerations) && (
        <dl class="recommendation__details">
          {recommendation.bestFor && (
            <div>
              <dt>Best for</dt>
              <dd>{recommendation.bestFor}</dd>
            </div>
          )}
          {selectionGuidance && (
            <div>
              <dt>How to choose</dt>
              <dd>{selectionGuidance}</dd>
            </div>
          )}
          {recommendation.considerations && (
            <div>
              <dt>{product ? "Before you buy" : "What to consider"}</dt>
              <dd>{recommendation.considerations}</dd>
            </div>
          )}
        </dl>
      )
    }
    {
      destination && !(isDemo && recommendation.shoppingOptions?.length) ? (
        <div class="recommendation__commerce">
          <a
            class="button button--small"
            href={destination}
            target="_blank"
            rel={linkRel}
            aria-label={
              isDirectAffiliate
                ? `View ${title} on Amazon (opens in a new tab)`
                : `${isDemo ? "View demo for" : "View"} ${displayName} at ${product!.merchant} (opens in a new tab)`
            }
          >
            {isDirectAffiliate
              ? "View on Amazon"
              : isDemo
                ? `View demo at ${merchantLabel}`
                : `${isAffiliate ? "View at" : "View product at"} ${product!.merchant}`}
          </a>
        </div>
      ) : !recommendation.shoppingOptions?.length ? (
        <p class="recommendation__availability">No merchant link available.</p>
      ) : null
    }
    {
      recommendation.shoppingOptions?.length && (
        <details class="shopping-options">
          <summary>
            View {recommendation.shoppingOptions.length}{" "}
            {recommendation.shoppingOptions.length === 1 ? "option" : "options"} on Amazon
          </summary>
          <p class="shopping-options__notice">
            Compare product options for this gift idea; this is not a ranked list. Check current
            details on Amazon. As an Amazon Associate, we earn from qualifying purchases.
          </p>
          <ul class="shopping-options__list">
            {recommendation.shoppingOptions.map((option) => (
              <li>
                {option.imageUrl && (
                  <a
                    href={option.affiliateUrl}
                    target="_blank"
                    rel="sponsored nofollow noopener"
                    class="shopping-options__thumbnail"
                    aria-label={`View ${option.name} on Amazon (opens in a new tab)`}
                  >
                    <img
                      src={option.imageUrl}
                      alt={option.name}
                      width="96"
                      height="96"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  </a>
                )}
                <h3>{option.name}</h3>
                <p>{option.description}</p>
                {option.sources && <small>{sourceLabel(option.sources)}</small>}
                <a
                  href={option.affiliateUrl}
                  target="_blank"
                  rel="sponsored nofollow noopener"
                  aria-label={`View ${option.name} on Amazon (opens in a new tab)`}
                >
                  View on Amazon <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</article>
