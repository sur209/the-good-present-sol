---
import { PUBLIC_PATHS } from "@the-good-present/content-schema";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  theme?: "default" | "hub" | "guide";
}

const { title, description, theme = "default" } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class:list={[theme !== "default" && `theme-${theme}`]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header-shell">
      <div class="site-header">
        <a class="brand" href={PUBLIC_PATHS.home} aria-label="The Good Present home">
          <span aria-hidden="true">✦</span>
          The Good Present
        </a>
        <nav aria-label="Primary navigation">
          <a href={PUBLIC_PATHS.giftGuides}>Gift guides</a>
          <a href={PUBLIC_PATHS.about}>Our method</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer-shell">
      <div class="site-footer">
        <div>
          <a class="brand brand--footer" href={PUBLIC_PATHS.home}>
            <span aria-hidden="true">✦</span>
            The Good Present
          </a>
          <p>Useful, human-edited gift guides for people who show up for others.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href={PUBLIC_PATHS.giftGuides}>Gift guides</a>
          <a href={PUBLIC_PATHS.about}>About</a>
          <a href={PUBLIC_PATHS.affiliateDisclosure}>Affiliate disclosure</a>
        </nav>
        <p class="site-footer__note">
          Made for US readers · Prices and purchases live with merchants.
        </p>
      </div>
    </footer>
  </body>
</html>
