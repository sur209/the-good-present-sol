---
import { content, formatDate, clustersById, productsById } from "../lib/content.js";
import { recommendationIllustrations } from "../lib/illustrations.js";
import RecommendationCard from "../components/RecommendationCard.astro";
import { informationalLinks, relatedIdeas, sourceLabel } from "../lib/gift-resources.js";
import {
  guidePath,
  clusterPath,
  productDisplayName,
  recommendationDestination,
  type GiftGuide,
  type GuideRecommendation,
} from "@the-good-present/content-schema";
import {
  websiteStructuredData,
  guideStructuredData,
  breadcrumbStructuredData,
} from "../lib/structured-data.js";

const { guide, preview = false } = Astro.props as { guide?: GiftGuide; preview?: boolean };
const home = preview ? "/magazine/" : "/";
const cluster = guide ? clustersById.get(guide.clusterId)! : undefined;
const canonicalPath = guide ? guidePath(cluster!.slug, guide.slug) : "/";
const title = guide?.seoTitle ?? "The Good Present | Gifts chosen with care";
const description =
  guide?.seoDescription ??
  "Explore thoughtful gift guides, visual inspiration and concrete product options for the people in your life.";
const schemas = guide
  ? [
      guideStructuredData(Astro.site!, cluster!, guide),
      breadcrumbStructuredData(Astro.site!, [
        { name: "Home", path: "/" },
        { name: cluster!.title, path: clusterPath(cluster!.slug) },
        { name: guide.title, path: canonicalPath },
      ]),
    ]
  : [websiteStructuredData(Astro.site!)];
const guides = content.guides;
const nurseCluster = content.clusters.find(({ slug }) => slug === "nurse-gifts");
if (!nurseCluster) throw new Error('Canonical "nurse-gifts" cluster is missing.');
const featured = guides.find((item) => item.slug === "practical") ?? guides[0];
const href = (item: GiftGuide) =>
  preview
    ? `/magazine/${item.slug}/`
    : guidePath(clustersById.get(item.clusterId)!.slug, item.slug);
const label = (idea?: GuideRecommendation) =>
  idea?.heading ??
  (idea?.productId ? productDisplayName(productsById.get(idea.productId)!) : "Gift idea");
const visual = (idea?: GuideRecommendation) =>
  (idea && recommendationIllustrations[idea.id]?.src) ??
  idea?.shoppingOptions?.find((option) => option.imageUrl)?.imageUrl ??
  "/favicon.svg";
const cover = (item: GiftGuide) => item.recommendations[0];
const sections = [
  { title: "Mark a milestone", axes: ["occasion", "career-stage"] },
  {
    title: "Find their kind of gift",
    axes: ["gift-style", "recipient", "work-context", "budget", "general"],
  },
];
const related = guide
  ? [
      ...guides.filter((item) => guide.relatedGuideIds?.includes(item.id)),
      ...guides.filter((item) => item.id !== guide.id && !guide.relatedGuideIds?.includes(item.id)),
    ].slice(0, 4)
  : [];
const hasAffiliateLinks =
  !guide ||
  guide.recommendations.some((idea) => {
    const product = idea.productId ? productsById.get(idea.productId) : undefined;
    const destination = recommendationDestination(idea, product);
    return Boolean(
      idea.shoppingOptions?.length ||
      (destination &&
        (destination === idea.directAffiliateUrl || destination === product?.affiliateUrl)),
    );
  });
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(canonicalPath, Astro.site)} />
    <meta property="og:site_name" content="The Good Present" />
    <meta property="og:type" content={guide ? "article" : "website"} />
    <meta name="twitter:card" content="summary" />
    {guide && <meta property="article:published_time" content={guide.publishedAt} />}
    {guide?.updatedAt && <meta property="article:modified_time" content={guide.updatedAt} />}
    {
      schemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    {
      !preview && (
        <>
          <>
            <script
              is:inline
              async
              src="https://www.googletagmanager.com/gtag/js?id=G-2CHRWH3TGZ"
            />
            <script
              is:inline
              set:html={
                'window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag("js", new Date()); gtag("config", "G-2CHRWH3TGZ");'
              }
            />
          </>
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" />
    <title>{title}{preview ? " · Local preview" : ""}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {preview && <div class="preview">LOCAL DESIGN PREVIEW · Published content is unchanged</div>}
    <header>
      <div class="masthead wrap">
        <a class="brand" href={home}
          ><span>✦</span> The Good Present<span class="brand-note"
            >A little inspiration. A good gift.</span
          ></a
        >
        <form action={`${home}#browse`} role="search">
          <label for="search">Find a gift guide</label><input
            id="search"
            name="q"
            type="search"
            placeholder="Try graduation, practical, personalized…"
          /><button>Search →</button>
        </form>
      </div>
      <nav class="wrap" aria-label="Explore">
        <a href={`${home}#browse`}>All gift guides</a><a href={`${home}#milestones`}>Milestones</a
        ><a href={`${home}#styles`}>Gift styles</a><a href="/nurse-gifts/">Nurse gifts</a><a
          href="/about/">Our approach</a
        >
      </nav>
    </header>
    <main id="main" class="wrap">
      <p class={hasAffiliateLinks ? "guide-disclosure disclosure" : "disclosure"}>
        As an Amazon Associate, we earn from qualifying purchases. <a href="/affiliate-disclosure/"
          >About our links ↗</a
        >
      </p>
      {
        guide ? (
          <>
            <p class="eyebrow">
              <a href={home}>The magazine</a> /{" "}
              <a href={clusterPath(cluster!.slug)}>{cluster!.title}</a>
            </p>
            <div class="guide-heading">
              <>
                <p class="eyebrow">Gift guide · {guide.recommendations.length} ideas</p>
                <h1>{guide.title}</h1>
                <p class="intro">{guide.excerpt}</p>
                <p class="date">Updated {formatDate(guide.updatedAt ?? guide.publishedAt)}</p>
              </>
            </div>
            <div class="guide-banner">
              {guide.recommendations.slice(0, 3).map((idea) => (
                <a href={`#pick-${idea.position}`}>
                  <img src={visual(idea)} alt={label(idea)} />
                  <span>{label(idea)}</span>
                </a>
              ))}
            </div>
            <p class="introduction">{guide.introduction}</p>
            <section aria-labelledby="overview">
              <>
                <h2 id="overview">Every gift at a glance</h2>
                <div class="overview">
                  {guide.recommendations.map((idea) => (
                    <a href={`#pick-${idea.position}`}>
                      <img src={visual(idea)} alt="" loading="lazy" />
                      <span>{label(idea)}</span>
                    </a>
                  ))}
                </div>
              </>
            </section>
            <div class="reading-layout">
              <>
                <div>
                  {guide.recommendations.map((idea) =>
                    !idea.shoppingOptions?.length ? (
                      <RecommendationCard
                        recommendation={idea}
                        product={idea.productId ? productsById.get(idea.productId) : undefined}
                        illustration={recommendationIllustrations[idea.id]}
                      />
                    ) : (
                      <article class="idea" id={`pick-${idea.position}`}>
                        <p class="eyebrow">Gift idea {idea.position}</p>
                        <h2>{label(idea)}</h2>
                        <div class="idea-intro">
                          <img src={visual(idea)} alt={label(idea)} loading="lazy" />
                          <div>
                            <p>{idea.editorialDescription}</p>
                            <p>
                              <strong>Why it fits.</strong> {idea.whyItFits}
                            </p>
                          </div>
                        </div>
                        <h3 class="option-heading">Explore product options</h3>
                        <ul class="options">
                          {idea.shoppingOptions?.map((option) => (
                            <li>
                              {option.imageUrl && (
                                <img
                                  class="shopping-options__thumbnail"
                                  src={option.imageUrl}
                                  alt={option.name}
                                  loading="lazy"
                                  referrerpolicy="no-referrer"
                                />
                              )}
                              <div>
                                <h3>{option.name}</h3>
                                <p>{option.description}</p>
                                {option.sources && (
                                  <small class="product-source">
                                    {sourceLabel(option.sources)}
                                  </small>
                                )}
                                <a
                                  href={option.affiliateUrl}
                                  target="_blank"
                                  rel="sponsored nofollow noopener"
                                >
                                  View on Amazon ↗<span class="sr-only"> (opens in a new tab)</span>
                                </a>
                              </div>
                            </li>
                          ))}
                        </ul>
                        <details>
                          <summary>What to check before choosing</summary>
                          {idea.bestFor && (
                            <p>
                              <strong>Best for.</strong> {idea.bestFor}
                            </p>
                          )}
                          <p>{"selectionGuidance" in idea ? idea.selectionGuidance : undefined}</p>
                          <p>{idea.considerations}</p>
                        </details>
                        <div class="useful-links">
                          {relatedIdeas(guide, idea, guides).map((match) => (
                            <p>
                              <a href={`${href(match.guide)}#pick-${match.position}`}>
                                See this gift in {match.guide.title} →
                              </a>
                            </p>
                          ))}
                          {informationalLinks(label(idea)).map((resource) => (
                            <p>
                              <a href={resource.url} target="_blank" rel="noopener noreferrer">
                                {resource.label} ↗
                              </a>
                            </p>
                          ))}
                        </div>
                      </article>
                    ),
                  )}
                </div>
                <aside class="sidebar">
                  <h2>Another way in</h2>
                  {related.map((item) => (
                    <a href={href(item)}>
                      <img src={visual(cover(item)!)} alt="" loading="lazy" />
                      <strong>{item.title}</strong>
                    </a>
                  ))}
                  <a href="#overview">↑ Every gift at a glance</a>
                </aside>
              </>
            </div>
            <section>
              <>
                {guide.conclusion && <p class="introduction">{guide.conclusion}</p>}
                <h2>Keep exploring</h2>
                <p>
                  <a
                    href="https://consumer.ftc.gov/articles/online-shopping"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Before buying online: comparison and shopping tips from the FTC ↗
                  </a>
                </p>
                <div class="cards">
                  {related.map((item) => (
                    <a class="card" href={href(item)}>
                      <img src={visual(cover(item)!)} alt="" loading="lazy" />
                      <h3>{item.title}</h3>
                      <p>{item.excerpt}</p>
                    </a>
                  ))}
                </div>
              </>
            </section>
          </>
        ) : (
          <>
            <div class="opening">
              <aside class="latest">
                <h2>Find your way in</h2>
                {guides.slice(0, 5).map((item) => (
                  <a href={href(item)}>
                    <strong>{item.title}</strong>
                    <span>{item.recommendations.length} gift ideas →</span>
                  </a>
                ))}
              </aside>
              <article class="lead">
                <>
                  <a href={href(featured)}>
                    <>
                      <div class="collage">
                        {featured.recommendations.slice(0, 3).map((idea) => (
                          <img src={visual(idea)} alt={label(idea)} />
                        ))}
                      </div>
                      <p class="eyebrow">The everyday edit</p>
                      <h1>Good gifts, worth a closer look.</h1>
                      <h2>{featured.title} →</h2>
                    </>
                  </a>
                  <p>{featured.excerpt}</p>
                </>
              </article>
              <aside class="small-finds">
                <h2>A few discoveries</h2>
                {guides.slice(3, 6).map((item) => {
                  const idea = cover(item)!;
                  return (
                    <a href={`${href(item)}#pick-${idea.position}`}>
                      <img src={visual(idea)} alt="" />
                      <strong>{label(idea)}</strong>
                      <span>Explore the idea →</span>
                    </a>
                  );
                })}
              </aside>
            </div>
            <section id="browse">
              <>
                <div class="section-heading">
                  <>
                    <div>
                      <>
                        <p class="eyebrow">Browse the magazine</p>
                        <h2>Who are you celebrating?</h2>
                        <a href="/nurse-gifts/">
                          <Fragment set:html="<h3>Nurse Gifts</h3>" />
                        </a>
                      </>
                    </div>
                    <p id="result-count" aria-live="polite">
                      {guides.length} guides to explore
                    </p>
                  </>
                </div>
                <p id="empty" hidden>
                  No matching guides. Try another word.
                </p>
                <div class="cards" id="guide-results">
                  {guides.map((item) => (
                    <a
                      class="card"
                      data-search={`${item.title} ${item.excerpt}`.toLowerCase()}
                      href={href(item)}
                    >
                      <img src={visual(cover(item)!)} alt="" loading="lazy" />
                      <span class="eyebrow">{item.recommendations.length} gift ideas</span>
                      <h3>{item.title}</h3>
                      <p>{item.excerpt}</p>
                    </a>
                  ))}
                </div>
              </>
            </section>
            {sections.map((section, index) => {
              const items = guides.filter((item) => section.axes.includes(item.primaryAxis));
              return (
                <section id={index === 0 ? "milestones" : "styles"}>
                  <h2>{section.title}</h2>
                  <div class="editorial-row">
                    {items.slice(0, 4).map((item) => (
                      <a href={href(item)}>
                        <img src={visual(cover(item)!)} alt="" loading="lazy" />
                        <h3>{item.title}</h3>
                        <p>{item.excerpt}</p>
                        <span>Explore the guide →</span>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
          </>
        )
      }
    </main>
    <footer class="wrap">
      <a class="brand" href={home}>✦ The Good Present</a><p>
        Follow your curiosity. Find something that feels like them.
      </p>{
        preview ? (
          <a href="/">View the current website →</a>
        ) : (
          <a href="/gift-guides/">All gift guides →</a>
        )
      }
    </footer>
    <script>
      const input = document.querySelector<HTMLInputElement>("#search");
      const results = [...document.querySelectorAll<HTMLElement>("[data-search]")];
      function filterGuides(query: string) {
        if (!results.length) return;
        const words = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
        results.forEach((card) => {
          card.hidden = !words.every((word) => card.dataset.search!.includes(word));
        });
        const count = results.filter((card) => !card.hidden).length;
        document.querySelector("#result-count")!.textContent = `${count} guides to explore`;
        document.querySelector<HTMLElement>("#empty")!.hidden = count > 0;
      }
      if (input && results.length) {
        input.value = new URLSearchParams(location.search).get("q") ?? "";
        filterGuides(input.value);
        input.addEventListener("input", () => filterGuides(input.value));
        input.form?.addEventListener("submit", (event) => {
          event.preventDefault();
          filterGuides(input.value);
          document.querySelector("#browse")?.scrollIntoView();
        });
      }
    </script>
  </body>
</html>
<style>
  .product-source {
    display: block;
    color: #666;
    font-size: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .useful-links {
    font-size: 0.85rem;
    margin-top: 1rem;
  }
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 150px;
  }
  :global(body) {
    margin: 0;
    background: #fffdf8;
    color: #25251e;
    font-family: Arial, sans-serif;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(a:hover h3),
  :global(a:hover strong) {
    text-decoration: underline;
  }
  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible),
  :global(summary:focus-visible) {
    outline: 3px solid #94651b;
    outline-offset: 5px;
  }
  :global(img) {
    display: block;
    width: 100%;
    object-fit: contain;
  }
  :global([hidden]) {
    display: none !important;
  }
  .wrap {
    max-width: 1280px;
    margin: auto;
    padding: 0 28px;
  }
  .preview {
    text-align: center;
    background: #f4d566;
    padding: 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  header {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #fffdf8;
    border-bottom: 1px solid #ddd8cc;
  }
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding-top: 22px;
    padding-bottom: 20px;
  }
  .brand {
    font-family: Georgia, serif;
    font-weight: bold;
    font-size: 28px;
    white-space: nowrap;
  }
  .brand > span:first-child {
    color: #aa771b;
  }
  .brand-note {
    display: block;
    font:
      12px Arial,
      sans-serif;
    letter-spacing: 0.06em;
    margin-top: 8px;
  }
  form {
    display: flex;
    border: 1px solid #8c8a7c;
    border-radius: 5px;
    max-width: 640px;
    width: 100%;
    padding: 8px;
    align-items: center;
    gap: 10px;
  }
  form label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  input {
    width: 100%;
    border: 0;
    background: transparent;
    font-size: 15px;
    padding: 6px;
    min-width: 0;
  }
  button {
    border: 0;
    background: #f4d566;
    padding: 10px;
    white-space: nowrap;
    cursor: pointer;
  }
  nav {
    display: flex;
    gap: 32px;
    padding-bottom: 15px;
    font-size: 14px;
    font-weight: bold;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .disclosure {
    text-align: center;
    font-size: 12px;
    padding: 16px 0;
    color: #666;
  }
  .disclosure a {
    text-decoration: underline;
  }
  .opening {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 190px;
    gap: 30px;
    margin: 20px 0 70px;
  }
  h1,
  h2,
  h3 {
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  h1 {
    font-size: clamp(36px, 4vw, 56px);
    margin: 15px 0;
  }
  h2 {
    font-size: 32px;
  }
  h3 {
    font-size: 24px;
    margin: 14px 0;
  }
  p {
    line-height: 1.55;
  }
  .eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: bold;
  }
  .latest h2,
  .small-finds h2,
  .sidebar h2 {
    font:
      24px Georgia,
      serif;
    border-top: 2px solid;
    padding-top: 10px;
    margin: 0 0 18px;
  }
  .latest a {
    display: block;
    margin-bottom: 28px;
    font-size: 17px;
    line-height: 1.3;
  }
  .latest span,
  .small-finds span {
    display: block;
    font-size: 12px;
    margin-top: 10px;
    color: #666;
  }
  .collage {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
    height: 360px;
    background: #e9dfcd;
    gap: 12px;
    padding: 18px;
  }
  .collage img {
    height: 100%;
    min-height: 0;
    background: #fff8eb;
  }
  .collage img:first-child {
    grid-row: span 2;
  }
  .lead h1 {
    border-top: 5px solid;
    padding-top: 16px;
  }
  .lead h2 {
    font-size: 22px;
  }
  .lead > p {
    font:
      19px/1.5 Georgia,
      serif;
  }
  .small-finds a {
    display: block;
    margin-bottom: 25px;
  }
  .small-finds img {
    height: 130px;
    background: white;
    margin-bottom: 12px;
  }
  .small-finds strong {
    font-size: 16px;
  }
  section {
    border-top: 5px solid;
    margin: 65px 0;
    padding-top: 8px;
  }
  section h2 {
    margin: 14px 0 30px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }
  .card img {
    height: 190px;
    background: #f0eadd;
    margin-bottom: 20px;
  }
  .card p {
    font:
      17px/1.5 Georgia,
      serif;
    color: #555;
  }
  .card {
    padding-bottom: 25px;
  }
  .editorial-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 28px;
  }
  .editorial-row img {
    height: 180px;
    background: #efe4cf;
  }
  .editorial-row > a:first-child img {
    height: 290px;
  }
  .editorial-row p {
    font:
      17px/1.5 Georgia,
      serif;
  }
  .editorial-row span {
    font-size: 13px;
    font-weight: bold;
  }
  .guide-heading {
    max-width: 920px;
    border-top: 5px solid;
    padding-top: 15px;
  }
  .intro {
    font:
      23px/1.45 Georgia,
      serif;
  }
  .date {
    font-size: 12px;
    color: #666;
  }
  .guide-banner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: #ede2cc;
    padding: 25px;
    gap: 20px;
    margin: 30px 0;
  }
  .guide-banner img {
    height: 250px;
  }
  .guide-banner span {
    display: block;
    font-weight: bold;
    text-align: center;
    margin-top: 14px;
  }
  .introduction {
    max-width: 850px;
    font:
      21px/1.65 Georgia,
      serif;
  }
  .overview {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 22px;
  }
  .overview img {
    height: 100px;
    background: #f1edde;
    margin-bottom: 10px;
  }
  .overview span {
    font-size: 13px;
    font-weight: bold;
    line-height: 1.35;
  }
  .reading-layout {
    display: grid;
    grid-template-columns: minmax(0, 850px) 230px;
    gap: 65px;
  }
  .idea {
    border-top: 2px solid;
    margin: 45px 0 65px;
    padding-top: 20px;
    scroll-margin-top: 150px;
  }
  .idea h2 {
    font-size: 36px;
    margin-top: 12px;
  }
