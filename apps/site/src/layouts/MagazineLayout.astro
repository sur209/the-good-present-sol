---
import { content, formatDate, clustersById, productsById } from "../lib/content.js";
import { recommendationIllustrations } from "../lib/illustrations.js";
import RecommendationCard from "../components/RecommendationCard.astro";
import { informationalLinks, relatedIdeas, sourceLabel } from "../lib/gift-resources.js";
import {
  guidePath,
  clusterPath,
  productDisplayName,
  recommendationDestination,
  type GiftGuide,
  type GuideRecommendation,
} from "@the-good-present/content-schema";
import {
  websiteStructuredData,
  guideStructuredData,
  breadcrumbStructuredData,
} from "../lib/structured-data.js";

const { guide, preview = false } = Astro.props as { guide?: GiftGuide; preview?: boolean };
const home = preview ? "/magazine/" : "/";
const cluster = guide ? clustersById.get(guide.clusterId)! : undefined;
const canonicalPath = guide ? guidePath(cluster!.slug, guide.slug) : "/";
const title = guide?.seoTitle ?? "The Good Present | Gifts chosen with care";
const description =
  guide?.seoDescription ??
  "Explore thoughtful gift guides, visual inspiration and concrete product options for the people in your life.";
const schemas = guide
  ? [
      guideStructuredData(Astro.site!, cluster!, guide),
      breadcrumbStructuredData(Astro.site!, [
        { name: "Home", path: "/" },
        { name: cluster!.title, path: clusterPath(cluster!.slug) },
        { name: guide.title, path: canonicalPath },
      ]),
    ]
  : [websiteStructuredData(Astro.site!)];
const guides = content.guides;
const nurseCluster = content.clusters.find(({ slug }) => slug === "nurse-gifts");
if (!nurseCluster) throw new Error('Canonical "nurse-gifts" cluster is missing.');
const featured = guides.find((item) => item.slug === "practical") ?? guides[0];
const href = (item: GiftGuide) =>
  preview
    ? `/magazine/${item.slug}/`
    : guidePath(clustersById.get(item.clusterId)!.slug, item.slug);
const label = (idea?: GuideRecommendation) =>
  idea?.heading ??
  (idea?.productId ? productDisplayName(productsById.get(idea.productId)!) : "Gift idea");
const visual = (idea?: GuideRecommendation) =>
  (idea && recommendationIllustrations[idea.id]?.src) ??
  idea?.shoppingOptions?.find((option) => option.imageUrl)?.imageUrl ??
  "/favicon.svg";
const cover = (item: GiftGuide) => item.recommendations[0];
const categoryNames: Record<string, string> = {
  "under-25": "Under $25",
  practical: "Practical gifts",
  "personalized-gifts-for-nurses": "Personalized gifts",
  "funny-gifts-for-nurses": "Funny gifts",
  graduation: "Graduation",
};
const sections = [
  { title: "Mark a milestone", axes: ["occasion", "career-stage"] },
  {
    title: "Find their kind of gift",
    axes: ["gift-style", "recipient", "work-context", "budget", "general"],
  },
];
const related = guide
  ? [
      ...guides.filter((item) => guide.relatedGuideIds?.includes(item.id)),
      ...guides.filter((item) => item.id !== guide.id && !guide.relatedGuideIds?.includes(item.id)),
    ].slice(0, 4)
  : [];
const hasAffiliateLinks =
  !guide ||
  guide.recommendations.some((idea) => {
    const product = idea.productId ? productsById.get(idea.productId) : undefined;
    const destination = recommendationDestination(idea, product);
    return Boolean(
      idea.shoppingOptions?.length ||
      (destination &&
        (destination === idea.directAffiliateUrl || destination === product?.affiliateUrl)),
    );
  });
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(canonicalPath, Astro.site)} />
    <meta property="og:site_name" content="The Good Present" />
    <meta property="og:type" content={guide ? "article" : "website"} />
    <meta name="twitter:card" content="summary" />
    {guide && <meta property="article:published_time" content={guide.publishedAt} />}
    {guide?.updatedAt && <meta property="article:modified_time" content={guide.updatedAt} />}
    {
      schemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    {
      !preview && (
        <>
          <>
            <script
              is:inline
              async
              src="https://www.googletagmanager.com/gtag/js?id=G-2CHRWH3TGZ"
            />
            <script
              is:inline
              set:html={
                'window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag("js", new Date()); gtag("config", "G-2CHRWH3TGZ");'
              }
            />
          </>
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" />
    <title>{title}{preview ? " · Local preview" : ""}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {preview && <div class="preview">LOCAL DESIGN PREVIEW · Published content is unchanged</div>}
    <header>
      <div class="masthead wrap">
        <a class="brand" href={home}
          >The Good Present<span class="brand-note">A little inspiration. A good gift.</span></a
        >
        <form action={`${home}#browse`} role="search">
          <label for="search">Find a gift guide</label><input
            id="search"
            name="q"
            type="search"
            placeholder="Try graduation, practical, personalized…"
          /><button>Search →</button>
        </form>
      </div>
    </header>
    <main id="main" class="wrap">
      <p class={hasAffiliateLinks ? "guide-disclosure disclosure" : "disclosure"}>
        As an Amazon Associate, we earn from qualifying purchases. <a href="/affiliate-disclosure/"
          >About our links ↗</a
        >
      </p>
      {
        guide ? (
          <>
            <p class="eyebrow">
              <a href={home}>The magazine</a> /{" "}
              <a href={clusterPath(cluster!.slug)}>{cluster!.title}</a>
            </p>
            <>
              <div class="guide-hero">
                <div class="guide-heading">
                  <>
                    <p class="eyebrow">Gift guide · {guide.recommendations.length} ideas</p>
                    <h1>{guide.title}</h1>
                    <p class="intro">{guide.excerpt}</p>
                    <p class="date">Updated {formatDate(guide.updatedAt ?? guide.publishedAt)}</p>
                  </>
                </div>
                <div class="guide-banner">
                  {guide.recommendations.slice(0, 3).map((idea) => (
                    <a href={`#pick-${idea.position}`}>
                      <img src={visual(idea)} alt={label(idea)} />
                      <span>{label(idea)}</span>
                    </a>
                  ))}
                </div>
              </div>
              <p class="introduction">{guide.introduction}</p>
            </>
            <section aria-labelledby="overview">
              <>
                <h2 id="overview">Every gift at a glance</h2>
                <div class="overview">
                  {guide.recommendations.map((idea) => (
                    <a href={`#pick-${idea.position}`}>
                      <img src={visual(idea)} alt="" loading="lazy" />
                      <span>{label(idea)}</span>
                    </a>
                  ))}
                </div>
              </>
            </section>
            <div class="reading-layout">
              <>
                <div>
                  {guide.recommendations.map((idea) =>
                    !idea.shoppingOptions?.length ? (
                      <RecommendationCard
                        recommendation={idea}
                        product={idea.productId ? productsById.get(idea.productId) : undefined}
                        illustration={recommendationIllustrations[idea.id]}
                      />
                    ) : (
                      <article class="idea" id={`pick-${idea.position}`}>
                        <p class="eyebrow">Gift idea {idea.position}</p>
                        <h2>{label(idea)}</h2>
                        <div class="idea-intro">
                          <img src={visual(idea)} alt={label(idea)} loading="lazy" />
                          <div>
                            <p>{idea.editorialDescription}</p>
                            <p>
                              <strong>Why it fits.</strong> {idea.whyItFits}
                            </p>
                          </div>
                        </div>
                        <h3 class="option-heading">Explore product options</h3>
                        <ul class="options">
                          {idea.shoppingOptions?.map((option) => (
                            <li>
                              {option.imageUrl && (
                                <img
                                  class="shopping-options__thumbnail"
                                  src={option.imageUrl}
                                  alt={option.name}
                                  loading="lazy"
                                  referrerpolicy="no-referrer"
                                />
                              )}
                              <div>
                                <h3>{option.name}</h3>
                                <p>{option.description}</p>
                                {option.sources && (
                                  <small class="product-source">
                                    {sourceLabel(option.sources)}
                                  </small>
                                )}
                                <a
                                  href={option.affiliateUrl}
                                  target="_blank"
                                  rel="sponsored nofollow noopener"
                                >
                                  View on Amazon ↗<span class="sr-only"> (opens in a new tab)</span>
                                </a>
                              </div>
                            </li>
                          ))}
                        </ul>
                        <details>
                          <summary>What to check before choosing</summary>
                          {idea.bestFor && (
                            <p>
                              <strong>Best for.</strong> {idea.bestFor}
                            </p>
                          )}
                          <p>{"selectionGuidance" in idea ? idea.selectionGuidance : undefined}</p>
                          <p>{idea.considerations}</p>
                        </details>
                        <div class="useful-links">
                          {relatedIdeas(guide, idea, guides).map((match) => (
                            <p>
                              <a href={`${href(match.guide)}#pick-${match.position}`}>
                                See this gift in {match.guide.title} →
                              </a>
                            </p>
                          ))}
                          {informationalLinks(label(idea)).map((resource) => (
                            <p>
                              <a href={resource.url} target="_blank" rel="noopener noreferrer">
                                {resource.label} ↗
                              </a>
                            </p>
                          ))}
                        </div>
                      </article>
                    ),
                  )}
                </div>
                <aside class="sidebar">
                  <>
                    <h2>In this guide</h2>
                    <ol class="contents">
                      {guide.recommendations.map((idea) => (
                        <li>
                          <a href={`#pick-${idea.position}`}>{label(idea)}</a>
                        </li>
                      ))}
                    </ol>
                    <h2>Related guides</h2>
                  </>
                  {related.map((item) => (
                    <a href={href(item)}>
                      <img src={visual(cover(item)!)} alt="" loading="lazy" />
                      <strong>{item.title}</strong>
                    </a>
                  ))}
                  <a href="#overview">↑ Every gift at a glance</a>
                </aside>
              </>
            </div>
            <section>
              <>
                {guide.conclusion && <p class="introduction">{guide.conclusion}</p>}
                <h2>Keep exploring</h2>
                <p>
                  <a
                    href="https://consumer.ftc.gov/articles/online-shopping"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Before buying online: comparison and shopping tips from the FTC ↗
                  </a>
                </p>
                <div class="cards">
                  {related.map((item) => (
                    <a class="card" href={href(item)}>
                      <img src={visual(cover(item)!)} alt="" loading="lazy" />
                      <h3>{item.title}</h3>
                      <p>{item.excerpt}</p>
                    </a>
                  ))}
                </div>
              </>
            </section>
          </>
        ) : (
          <>
            <section class="home-hero" aria-labelledby="home-title">
              <div class="hero-copy">
                <p class="eyebrow">Gifts for a brighter everyday</p>
                <h1 id="home-title">
                  Thoughtful gifts.
                  <br />A little more inspiration.
                </h1>
                <p class="intro">
                  From everyday surprises to life's big moments, find something useful, beautiful,
                  and right for them.
                </p>
                <a class="primary-cta" href="#browse">
                  Explore gift guides →
                </a>
                <a class="quiet-link" href="/nurse-gifts/">
                  Explore Nurse Gifts →
                </a>
              </div>
              <a class="hero-art" href={href(featured)} aria-label={featured.title}>
                {featured.recommendations.slice(0, 3).map((idea) => (
                  <img src={visual(idea)} alt={label(idea)} />
                ))}
                <span class="hero-caption">
                  Small gifts.
                  <br />
                  Bright moments.
                </span>
              </a>
            </section>
            <section class="category-section">
              <h2>Find your kind of gift</h2>
              <div class="category-grid">
                {[
                  "under-25",
                  "practical",
                  "personalized-gifts-for-nurses",
                  "funny-gifts-for-nurses",
                  "graduation",
                ].map((slug) => {
                  const item = guides.find((item) => item.slug === slug);
                  return (
                    item && (
                      <a href={href(item)}>
                        <img src={visual(cover(item))} alt="" />
                        <strong>{categoryNames[slug]} →</strong>
                      </a>
                    )
                  );
                })}
              </div>
            </section>
            <section class="spotlight">
              <div>
                <>
                  <p class="eyebrow">The everyday edit</p>
                  <h2>The gifts that make life a little brighter.</h2>
                  <p>
                    Start with the person, not just the occasion. Explore our guides for ideas and
                    concrete options to compare.
                  </p>
                  <a class="outline-cta" href="/about/">
                    How we choose →
                  </a>
                </>
              </div>
              <div class="spotlight-cards">
                {guides.slice(2, 5).map((item) => (
                  <a class="card" href={href(item)}>
                    <img src={visual(cover(item))} alt="" loading="lazy" />
                    <p class="eyebrow">Gift guide</p>
                    <h3>{item.title}</h3>
                    <span>Explore the guide →</span>
                  </a>
                ))}
              </div>
            </section>
            <section id="browse">
              <>
                <div class="section-heading">
                  <>
                    <div>
                      <>
                        <p class="eyebrow">Browse the magazine</p>
                        <h2>Who are you celebrating?</h2>
                        <a href="/nurse-gifts/">
                          <Fragment set:html="<h3>Nurse Gifts</h3>" />
                        </a>
                      </>
                    </div>
                    <p id="result-count" aria-live="polite">
                      {guides.length} guides to explore
                    </p>
                  </>
                </div>
                <p id="empty" hidden>
                  No matching guides. Try another word.
                </p>
                <div class="cards" id="guide-results">
                  {guides.map((item) => (
                    <a
                      class="card"
                      data-search={`${item.title} ${item.excerpt}`.toLowerCase()}
                      href={href(item)}
                    >
                      <img src={visual(cover(item)!)} alt="" loading="lazy" />
                      <span class="eyebrow">{item.recommendations.length} gift ideas</span>
                      <h3>{item.title}</h3>
                      <p>{item.excerpt}</p>
                    </a>
                  ))}
                </div>
              </>
            </section>
            {sections.map((section, index) => {
              const items = guides.filter((item) => section.axes.includes(item.primaryAxis));
              return (
                <section id={index === 0 ? "milestones" : "styles"}>
                  <h2>{section.title}</h2>
                  <div class="editorial-row">
                    {items.slice(0, 4).map((item) => (
                      <a href={href(item)}>
                        <img src={visual(cover(item)!)} alt="" loading="lazy" />
                        <h3>{item.title}</h3>
                        <p>{item.excerpt}</p>
                        <span>Explore the guide →</span>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
          </>
        )
      }
    </main>
    <footer class="wrap">
      <a href="/about/">About</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><small
        >© {new Date().getUTCFullYear()} The Good Present</small
      >
    </footer>
    <script>
      const input = document.querySelector<HTMLInputElement>("#search");
      const results = [...document.querySelectorAll<HTMLElement>("[data-search]")];
      function filterGuides(query: string) {
        if (!results.length) return;
        const words = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
        results.forEach((card) => {
          card.hidden = !words.every((word) => card.dataset.search!.includes(word));
        });
        const count = results.filter((card) => !card.hidden).length;
        document.querySelector("#result-count")!.textContent = `${count} guides to explore`;
        document.querySelector<HTMLElement>("#empty")!.hidden = count > 0;
      }
      if (input && results.length) {
        input.value = new URLSearchParams(location.search).get("q") ?? "";
        filterGuides(input.value);
        input.addEventListener("input", () => filterGuides(input.value));
        input.form?.addEventListener("submit", (event) => {
          event.preventDefault();
          filterGuides(input.value);
          document.querySelector("#browse")?.scrollIntoView();
        });
      }
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 110px;
  }
  :global(body) {
    margin: 0;
    background: #fff;
    color: #252823;
    font-family: Arial, sans-serif;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(a:hover) {
    text-decoration: underline;
  }
  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible),
  :global(summary:focus-visible) {
    outline: 3px solid #54654c;
    outline-offset: 5px;
  }
  :global(img) {
    display: block;
    width: 100%;
    object-fit: contain;
  }
  :global([hidden]) {
    display: none !important;
  }
  .wrap {
    max-width: 1220px;
    margin: auto;
    padding: 0 28px;
  }
  header {
    position: sticky;
    top: 0;
    z-index: 4;
    background: #fffffff5;
    border-bottom: 1px solid #dedfd9;
  }
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .brand {
    font:
      bold 30px Georgia,
      serif;
    white-space: nowrap;
    letter-spacing: -0.04em;
  }
  .brand-note {
    display: block;
    font:
      10px Arial,
      sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-top: 8px;
  }
  form {
    display: flex;
    border: 1px solid #b9bcb4;
    border-radius: 3px;
    max-width: 560px;
    width: 100%;
    padding: 5px;
    align-items: center;
    gap: 10px;
  }
  form label,
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  input {
    width: 100%;
    border: 0;
    background: transparent;
    font-size: 14px;
    padding: 10px;
    min-width: 0;
  }
  button {
    border: 0;
    background: #303b2e;
    color: white;
    padding: 11px 16px;
    white-space: nowrap;
    cursor: pointer;
  }
  .disclosure {
    text-align: center;
    font-size: 11px;
    padding: 13px 0;
    color: #646860;
  }
  .disclosure a,
  .useful-links a {
    text-decoration: underline;
  }
  h1,
  h2,
  h3 {
    font-family: Georgia, serif;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(36px, 4.5vw, 58px);
    margin: 16px 0 20px;
  }
  h2 {
    font-size: 30px;
  }
  h3 {
    font-size: 22px;
    margin: 14px 0;
  }
  p {
    line-height: 1.6;
  }
  .eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: bold;
  }
  section {
    border-top: 1px solid #dedfd9;
    margin: 48px 0;
    padding-top: 20px;
  }
  section h2 {
    margin: 8px 0 24px;
  }
  .home-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 42px;
    background: #f3f4ee;
    border: 0;
    padding: 42px;
    margin: 10px 0 36px;
  }
  .hero-copy {
    max-width: 520px;
  }
  .intro {
    font-size: 18px;
    color: #50574d;
  }
  .primary-cta,
  .outline-cta {
    display: inline-block;
    padding: 13px 20px;
    border: 1px solid #303b2e;
    border-radius: 3px;
    font-size: 14px;
  }
  .primary-cta {
    background: #303b2e;
    color: white;
  }
  .quiet-link {
    display: block;
    font-size: 12px;
    margin-top: 18px;
    text-decoration: underline;
  }
  .hero-art {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
    height: 350px;
    position: relative;
    padding: 10px;
  }
  .hero-art img {
    min-height: 0;
    height: 100%;
    background: #f7efe1;
    border: 8px solid white;
    box-shadow: 0 2px 12px #25282313;
  }
  .hero-art img:first-child {
    grid-row: span 2;
    transform: rotate(-4deg);
  }
  .hero-art img:nth-child(2) {
    transform: rotate(5deg);
  }
  .hero-caption {
    position: absolute;
    bottom: -4px;
    right: -8px;
    background: #fff;
    box-shadow: 0 2px 12px #25282318;
    transform: rotate(4deg);
    padding: 16px;
    font:
      italic 20px Georgia,
      serif;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .category-grid a {
    border: 1px solid #d6d9d0;
    padding: 12px;
    background: #fafaf7;
  }
  .category-grid img {
    height: 120px;
    margin-bottom: 12px;
  }
  .category-grid strong {
    font-size: 14px;
  }
  .spotlight {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 38px;
    background: #f3f4ee;
    padding: 30px;
    border: 0;
  }
  .spotlight-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .spotlight .card {
    background: white;
  }
  .spotlight .card img {
    height: 160px;
  }
  .spotlight .card h3 {
    font-size: 20px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
  }
  .section-heading h3 {
    font-size: 17px;
  }
  #result-count {
    font-size: 13px;
    color: #646860;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    border: 1px solid #d6d9d0;
    padding: 12px;
    min-width: 0;
  }
  .card img {
    height: 170px;
    background: #f5f3ee;
    margin-bottom: 16px;
  }
  .card p {
    font-size: 14px;
    color: #646860;
  }
  .card span:not(.eyebrow) {
    font-size: 12px;
  }
  .editorial-row {
    display: grid;
