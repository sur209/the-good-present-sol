---
import MagazineLayout from "../../../layouts/MagazineLayout.astro";
import { clustersById, content } from "../../../lib/content.js";
export function getStaticPaths() {
  return content.guides.map((guide) => ({
    params: { clusterSlug: clustersById.get(guide.clusterId)!.slug, guideSlug: guide.slug },
    props: { guide },
  }));
}
---

<MagazineLayout guide={Astro.props.guide} />
