---
import {
  PUBLIC_PATHS,
  clusterPath,
  guidePath,
  type ClusterHub,
} from "@the-good-present/content-schema";

import Breadcrumbs from "../../components/Breadcrumbs.astro";
import GuideCard from "../../components/GuideCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { content } from "../../lib/content.js";
import { breadcrumbStructuredData, clusterStructuredData } from "../../lib/structured-data.js";
import { recommendationIllustrations } from "../../lib/illustrations.js";

export function getStaticPaths() {
  return content.clusters.map((cluster) => ({
    params: { clusterSlug: cluster.slug },
    props: { cluster },
  }));
}

interface Props {
  cluster: ClusterHub;
}

const { cluster } = Astro.props;
const clusterGuides = content.guides.filter((guide) => guide.clusterId === cluster.id);
const publicPath = clusterPath(cluster.slug);
const cover = clusterGuides[0]?.recommendations[0];
const coverImage =
  cover &&
  (recommendationIllustrations[cover.id]?.src ??
    cover.shoppingOptions?.find((option) => option.imageUrl)?.imageUrl);
const photoHeadings: Record<string, string> = {
  "night-shift": "A Cooling Pillowcase Set for Daytime Sleep",
  "thank-you-gifts-for-nurse-preceptors-and-mentors": "A Coffee Tasting Set",
  "practical-gifts-for-nurses": "Insulated Lunch Bag for Long Shifts",
  "gifts-for-new-nurses": "A Soft Lounge Robe",
  "gifts-for-male-nurses": "Automatic wristwatch",
  graduation: "A Ceramic Keepsake Jewelry Box",
  practical: "A Large Ceramic Baking Dish",
  "under-25": "A Glass Plant Propagation Station",
};
const productPhotos =
  cluster.slug === "nurse-gifts"
    ? clusterGuides.flatMap((guide) => {
        const idea = guide.recommendations.find(
          (idea) => idea.heading === photoHeadings[guide.slug],
        );
        const image = idea?.shoppingOptions?.find((option) => option.imageUrl)?.imageUrl;
        return idea && image ? [{ guide, idea, image }] : [];
      })
    : [];
const collage = productPhotos.filter(({ guide }) =>
  [
    "night-shift",
    "thank-you-gifts-for-nurse-preceptors-and-mentors",
    "practical-gifts-for-nurses",
    "gifts-for-male-nurses",
    "graduation",
    "under-25",
  ].includes(guide.slug),
);
---

<BaseLayout
  title={cluster.seoTitle}
  description={cluster.seoDescription}
  canonicalPath={publicPath}
  theme="hub"
  structuredData={[
    breadcrumbStructuredData(Astro.site!, [
      { name: "Home", path: PUBLIC_PATHS.home },
      { name: "Gift guides", path: PUBLIC_PATHS.giftGuides },
      { name: cluster.title, path: publicPath },
    ]),
    clusterStructuredData(Astro.site!, cluster, clusterGuides),
  ]}
>
  <div class="shell">
    <Breadcrumbs
      items={[
        { label: "Home", href: PUBLIC_PATHS.home },
        { label: "Gift guides", href: PUBLIC_PATHS.giftGuides },
        { label: cluster.title },
      ]}
    />
  </div>

  <header class="hub-hero shell">
    <div>
      <p class="eyebrow">Explore the collection</p>
      <h1>{cluster.title}</h1>
      <p class="lede">{cluster.excerpt}</p>
      <p>{cluster.introduction}</p>
      {
        clusterGuides.length > 0 && (
          <a class="button button--outline" href="#featured-guides">
            Explore the gift guides <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
    <div class="hub-hero__intro">
      {
        collage.length > 0 ? (
          <div class="hub-product-collage" aria-label="Gifts from our nurse gift guides">
            {collage.map(({ guide, idea, image }) => (
              <a
                href={`${guidePath(cluster.slug, guide.slug)}#pick-${idea.position}`}
                aria-label={idea.heading}
              >
                <img src={image} alt={idea.heading} width="320" height="320" />
              </a>
            ))}
          </div>
        ) : (
          coverImage && <img src={coverImage} alt={cover?.heading ?? cluster.title} />
        )
      }
    </div>
  </header>

  {
    clusterGuides.length === 0 && (
      <section class="hub-paths section shell" aria-labelledby="empty-guides">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">No guides yet</p>
            <h2 id="empty-guides">No focused guides are published in this cluster.</h2>
          </div>
          <p>
            Browse the published collection for more gift ideas.
            <a class="text-link" href={PUBLIC_PATHS.giftGuides}>
              All gift guides <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </section>
    )
  }

  {
    clusterGuides.length > 0 && (
      <section class="section section--ink" aria-labelledby="featured-guides">
        <div class="shell">
          <div class="section-heading section-heading--split">
            <div>
              <p class="eyebrow">Find their next gift</p>
              <h2 id="featured-guides">
                {cluster.slug === "nurse-gifts"
                  ? "Gift guides for nurses."
                  : `Explore ${cluster.title.toLowerCase()}.`}
              </h2>
            </div>
            <a class="text-link text-link--light" href={PUBLIC_PATHS.giftGuides}>
              All gift guides <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="guide-grid">
            {clusterGuides.map((guide, index) => (
              <GuideCard
                guide={guide}
                cluster={cluster}
                number={index + 1}
                coverImage={productPhotos.find((photo) => photo.guide.id === guide.id)?.image}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="hub-method section shell" aria-labelledby="hub-method-heading">
    <div>
      <p class="eyebrow">A thoughtful starting point</p>
      <h2 id="hub-method-heading">Choose with the person in mind.</h2>
    </div>
    <div>
      <p>
        Explore the {cluster.title} collection for useful objects, personal touches, and gifts for different
        moments. Each guide includes concrete options and details to check before buying.
      </p>
      <p>
        Think about what they enjoy, what they already own, and what would make their day a little
        brighter. The best choice does not have to be related to their work.
      </p>
      <a class="button button--outline" href={clusterPath(cluster.slug)}>Back to the top</a>
    </div>
  </section>
</BaseLayout>
