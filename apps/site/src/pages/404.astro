---
import { PUBLIC_PATHS } from "@the-good-present/content-schema";

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | The Good Present"
  description="The requested page could not be found."
  canonicalPath={PUBLIC_PATHS.notFound}
  noindex
>
  <section class="not-found shell">
    <div class="not-found__mark" aria-hidden="true">404</div>
    <div>
      <p class="eyebrow">That gift guide is not here</p>
      <h1>Wrong doorway. Easy way back.</h1>
      <p class="lede">
        This page may have moved, or the address may be incomplete. Start again with the published
        guides.
      </p>
      <div class="button-row">
        <a class="button" href="/gift-guides/">Browse gift guides</a>
        <a class="text-link" href="/">Return home <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
